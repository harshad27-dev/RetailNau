generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Only handles Profile Data, NOT auth
model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique // Foreign reference to auth-service AuthUser.id
  name      String?
  email     String?  @unique
  avatar    String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}