// ============================================================
// Kyrana — Prisma Schema
// Single source of truth for all database models
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SHOPKEEPER
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CREDIT
  OTHER
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum StockMovementType {
  PURCHASE       // stock added via supplier purchase
  SALE           // stock deducted on order
  ADJUSTMENT     // manual correction
  RETURN_IN      // returned from customer
  RETURN_OUT     // returned to supplier
  DAMAGE         // damaged/expired write-off
}

enum ExpenseCategory {
  RENT
  SALARY
  ELECTRICITY
  LOGISTICS
  PACKAGING
  MARKETING
  MAINTENANCE
  TAX
  OTHER
}

enum RecommendationCategory {
  STOCK
  PRICING
  SALES
  CUSTOMER
  BUNDLE
}

enum RecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

enum RecommendationStatus {
  PENDING    // not yet seen
  SEEN       // viewed by shopkeeper
  ACTED      // shopkeeper acted on it
  DISMISSED  // ignored
}

// ============================================================
// USER & SHOP
// ============================================================

model User {
  id             String     @id @default(cuid())
  name           String
  email          String?    @unique
  phone          String     @unique
  passwordHash   String
  role           UserRole   @default(SHOPKEEPER)
  status         UserStatus @default(PENDING_VERIFICATION)
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  avatarUrl      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  shop           Shop?

  @@map("users")
}

model Shop {
  id             String    @id @default(cuid())
  userId         String    @unique
  name           String
  address        String
  city           String
  state          String
  pincode        String
  gstin          String?   // GST Identification Number
  category       String    // grocery / pharmacy / electronics / etc.
  operatingHours Json?     // { mon: { open: "09:00", close: "21:00" }, ... }
  logoUrl        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  customers      Customer[]
  orders         Order[]
  expenses       Expense[]
  recommendations Recommendation[]

  @@map("shops")
}

// ============================================================
// PRODUCT & INVENTORY
// ============================================================

model Product {
  id             String    @id @default(cuid())
  shopId         String
  name           String
  sku            String?
  category       String
  description    String?
  sellingPrice   Decimal   @db.Decimal(10, 2)
  costPrice      Decimal   @db.Decimal(10, 2)
  unit           String    @default("pcs") // pcs, kg, litre, dozen
  imageUrl       String?
  hsnCode        String?   // HSN code for GST
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventory      InventoryItem?
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@unique([shopId, sku])
  @@map("products")
}

model InventoryItem {
  id              String    @id @default(cuid())
  productId       String    @unique
  quantity        Int       @default(0)
  alertThreshold  Int       @default(10) // low stock alert level
  batchNumber     String?
  expiryDate      DateTime?
  lastRestockedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  type        StockMovementType
  quantity    Int               // positive = in, negative = out
  costPrice   Decimal?          @db.Decimal(10, 2) // cost at time of movement
  reason      String?
  referenceId String?           // orderId or purchaseOrderId for traceability
  createdAt   DateTime          @default(now())

  // Relations
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

// ============================================================
// CUSTOMERS & ORDERS
// ============================================================

model Customer {
  id            String    @id @default(cuid())
  shopId        String
  name          String
  phone         String?
  email         String?
  totalSpend    Decimal   @default(0) @db.Decimal(12, 2)
  totalOrders   Int       @default(0)
  firstOrderAt  DateTime?
  lastOrderAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@unique([shopId, phone])
  @@map("customers")
}

model Order {
  id           String      @id @default(cuid())
  shopId       String
  customerId   String?     // nullable — walk-in customers possible
  orderNumber  String
  totalAmount  Decimal     @db.Decimal(12, 2)
  discount     Decimal     @default(0) @db.Decimal(10, 2)
  finalAmount  Decimal     @db.Decimal(12, 2)
  paymentMode  PaymentMode @default(CASH)
  status       OrderStatus @default(COMPLETED)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  shop         Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer     Customer?   @relation(fields: [customerId], references: [id])
  items        OrderItem[]

  @@unique([shopId, orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String   // snapshot at time of sale
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2) // selling price at time of sale
  costPrice   Decimal  @db.Decimal(10, 2) // cost price at time of sale
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  // Relations
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id          String          @id @default(cuid())
  shopId      String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  date        DateTime        @db.Date
  receiptUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

// ============================================================
// ANALYTICS — Pre-aggregated for fast dashboard loads
// ============================================================

model DailySalesAggregate {
  id          String   @id @default(cuid())
  shopId      String
  date        DateTime @db.Date
  totalOrders Int      @default(0)
  totalRevenue Decimal @default(0) @db.Decimal(12, 2)
  totalCogs   Decimal  @default(0) @db.Decimal(12, 2)
  totalProfit Decimal  @default(0) @db.Decimal(12, 2)
  avgOrderValue Decimal @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, date])
  @@map("daily_sales_aggregates")
}

model HourlySalesAggregate {
  id          String   @id @default(cuid())
  shopId      String
  dayOfWeek   Int      // 0=Sunday, 1=Monday ... 6=Saturday
  hour        Int      // 0-23
  orderCount  Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt   DateTime @updatedAt

  @@unique([shopId, dayOfWeek, hour])
  @@map("hourly_sales_aggregates")
}

// ============================================================
// SMART RECOMMENDATIONS
// ============================================================

model Recommendation {
  id          String                 @id @default(cuid())
  shopId      String
  category    RecommendationCategory
  ruleId      String                 // SR-01, PR-01, etc.
  priority    RecommendationPriority
  title       String
  message     String
  productId   String?                // linked product if applicable
  impactValue Decimal?               @db.Decimal(10, 2) // estimated ₹ impact
  status      RecommendationStatus   @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  // Relations
  shop        Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("recommendations")
}

model BasketPair {
  id               String   @id @default(cuid())
  shopId           String
  productAId       String
  productBId       String
  coOccurrenceCount Int     @default(0) // times bought together
  lastUpdated      DateTime @updatedAt

  @@unique([shopId, productAId, productBId])
  @@map("basket_pairs")
}
